---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/atom.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/' | absolute_url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  <author>
    <name>{{ site.data.profile.name | xml_escape }}</name>
  </author>
  <generator uri="https://jekyllrb.com/">Jekyll</generator>

  {% for post in site.posts limit:20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.excerpt | markdownify | xml_escape }}</summary>
    {% for category in post.categories %}
    <category term="{{ category | xml_escape }}"/>
    {% endfor %}
    {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {% endfor %}
  </entry>
  {% endfor %}

  {% assign legacy_limit = 20 | minus: site.posts.size %}
  {% if legacy_limit > 0 %}
    {% for post in site.data.legacy_posts limit:legacy_limit %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.path | absolute_url }}"/>
    <id>{{ post.path | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.summary | xml_escape }}</summary>
    <category term="{{ post.category | xml_escape }}"/>
    {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {% endfor %}
  </entry>
    {% endfor %}
  {% endif %}
</feed>
